"ServerScriptService.SKYKEEPERS.Bootstrap\":\"local Players=game:GetService('Players')\\nlocal shared=game:GetService('ReplicatedStorage'):WaitForChild('SKYKEEPERS')\\nlocal config=require(shared.Config.EconomyConfig)\\nlocal Economy=require(shared.Shared.Economy)\\nlocal world=require(script.Parent.Services.World).build()\\nlocal remote=Instance.new('RemoteEvent');remote.Name='State';remote.Parent=shared\\nlocal profiles={};local random=Random.new()\\nlocal function publish(player,p,message)\\n player:SetAttribute('SkyCoins',p.coins);player:SetAttribute('SkyHeart',p.level)\\n local count=0;for _,n in p.inventory do count+=n end;player:SetAttribute('BagCount',count)\\n remote:FireClient(player,{coins=p.coins,level=p.level,inventory=p.inventory,message=message})\\nend\\nlocal function ready(player,target)\\n local p=profiles[player];local char=player.Character;local root=char and char:FindFirstChild('HumanoidRootPart');local h=char and char:FindFirstChildOfClass('Humanoid')\\n if not p or not root or not h or h.Health<=0 or (root.Position-target.Position).Magnitude>config.prototype.gatherDistance then return nil end\\n local now=os.clock();if now-p.last<config.prototype.requestInterval then return nil end;p.last=now;return p\\nend\\nlocal function joined(player) local p={coins=0,level=1,inventory={},nodes={},last=-math.huge};profiles[player]=p;task.defer(function() player.RespawnLocation=world.model.AetherSpawn end);publish(player,p,'Welcome to SKYKEEPERS') end\\nPlayers.PlayerAdded:Connect(joined);Players.PlayerRemoving:Connect(function(p) profiles[p]=nil end)\\nfor _,p in Players:GetPlayers() do joined(p) end\\nfor id,node in world.nodes do node.ProximityPrompt.Triggered:Connect(function(player)\\n local p=ready(player,node);if not p then return end\\n local now=os.clock();if p.nodes[id] and now-p.nodes[id]<config.prototype.nodeCooldown then publish(player,p,'This node is recharging');return end\\n local total=0;for _,n in p.inventory do total+=n end;if total>=config.prototype.inventoryCap then return end\\n local item=Economy.roll(config.zones.WhisperingMeadows.drops,random:NextNumber()*100)\\n p.nodes[id]=now;p.inventory[item]=(p.inventory[item] or 0)+1;publish(player,p,'Found '..item..' ['..config.items[item].rarity..']')\\nend) end\\nworld.merchant.ProximityPrompt.Triggered:Connect(function(player)\\n local p=ready(player,world.merchant);if not p then return end\\n local value=Economy.sellValue(config,p.inventory);p.inventory={};p.coins+=value;publish(player,p,'Sold for '..value..' SC')\\nend)\\nworld.heart.ProximityPrompt.Triggered:Connect(function(player)\\n local p=ready(player,world.heart);if not p then return end\\n publish(player,p,Economy.upgrade(config,p) and 'Sky Heart upgraded!' or 'Need coins and materials; keep some resources for upgrades')\\nend)\\nprint('SKYKEEPERS prototype ready: session-only data; no purchases or persistent writes')\\n\",\"ReplicatedStorage.SKYKEEPERS.Shared.Economy\":\"--!strict\\nlocal Economy = {}\\nfunction Economy.roll(drops, roll: number): string\\n assert(roll >= 0 and roll < 100, 'roll outside [0,100)')\\n local sum = 0\\n for _, row in drops do sum += row[2]; if roll < sum then return row[1] end end\\n error('invalid drop table')\\nend\\nfunction Economy.sellValue(config, inventory): number\\n local sum = 0\\n for id, count in inventory do\\n  assert(config.items[id] and count >= 0 and count % 1 == 0, 'invalid inventory')\\n  sum += config.items[id].price * count\\n end\\n return sum\\nend\\nfunction Economy.upgrade(config, profile): boolean\\n local cost = config.upgrades[profile.level]\\n if not cost or profile.coins < cost.coins then return false end\\n for id,n in cost.items do if (profile.inventory[id] or 0) < n then return false end end\\n profile.coins -= cost.coins\\n for id,n in cost.items do profile.inventory[id] -= n end\\n profile.level += 1\\n return true\\nend\\nreturn Economy\\n\",\"ServerScriptService.SKYKEEPERS.Services.World\":\"local World = {}\\nfunction World.build()\\n local existing=workspace:FindFirstChild('SKYKEEPERS_WORLD')\\n if existing then\\n  assert(existing:GetAttribute('SkykeepersGenerated')==true, 'Unmanaged world name collision')\\n  local nodes={} for i=1,9 do nodes[i]=existing:WaitForChild('Gather_'..i) end\\n  return {model=existing,nodes=nodes,merchant=existing.Merchant,heart=existing.SkyHeart}\\n end\\n local world = Instance.new('Model'); world.Name = 'SKYKEEPERS_WORLD';world:SetAttribute('SkykeepersGenerated',true)\\n local function part(name,size,pos,color,material,shape)\\n  local p=Instance.new('Part');p.Name=name;p.Size=size;p.Position=pos;p.Color=color;p.Material=material or Enum.Material.SmoothPlastic;p.Anchored=true\\n  if shape then p.Shape=shape end\\n  p.Parent=world;return p\\n end\\n local green=Color3.fromRGB(100,174,133);local stone=Color3.fromRGB(67,75,106);local cyan=Color3.fromRGB(87,224,255)\\n local function island(name,x,z,r)\\n  local top=part(name,Vector3.new(5,r*2,r*2),Vector3.new(x,0,z),green,nil,Enum.PartType.Cylinder);top.Orientation=Vector3.new(0,0,90)\\n  local rock=part(name..'_Rock',Vector3.new(r*1.6,14,r*1.6),Vector3.new(x,-8,z),stone,nil,Enum.PartType.Ball)\\n end\\n island('AetherHub',0,0,40);island('WhisperingMeadows',0,-104,36);island('PlayerIsland',74,0,21)\\n part('MeadowBridge',Vector3.new(9,2,47),Vector3.new(0,1,-56),Color3.fromRGB(167,139,101))\\n part('HomeBridge',Vector3.new(28,2,8),Vector3.new(47,1,0),Color3.fromRGB(167,139,101))\\n local spawn=Instance.new('SpawnLocation');spawn.Name='AetherSpawn';spawn.Size=Vector3.new(8,1,8);spawn.Position=Vector3.new(0,3,22);spawn.Anchored=true;spawn.Neutral=true;spawn.Color=cyan;spawn.Parent=world\\n local heart=part('SkyHeart',Vector3.new(4,9,4),Vector3.new(74,8,0),cyan,Enum.Material.Neon);heart.Orientation=Vector3.new(0,0,20)\\n local merchant=part('Merchant',Vector3.new(5,7,5),Vector3.new(-14,6,5),Color3.fromRGB(214,169,81))\\n local prompt=Instance.new('ProximityPrompt');prompt.ActionText='Sell gathered resources';prompt.ObjectText='Sky Merchant';prompt.HoldDuration=0.4;prompt.MaxActivationDistance=12;prompt.Parent=merchant\\n local upgrade=Instance.new('ProximityPrompt');upgrade.ActionText='Upgrade Sky Heart';upgrade.ObjectText='Materials + Sky Coins';upgrade.HoldDuration=0.5;upgrade.MaxActivationDistance=12;upgrade.Parent=heart\\n local nodes={}\\n for i=1,9 do local a=(i-1)*math.pi*2/9;local p=part('Gather_'..i,Vector3.new(3,5,3),Vector3.new(math.cos(a)*24,5,-104+math.sin(a)*24),cyan,Enum.Material.Neon);p.Orientation=Vector3.new(0,i*31,12)\\n  local q=Instance.new('ProximityPrompt');q.ActionText='Gather';q.ObjectText='70% Cloudwood / 25% Skyglass / 5% Starbloom';q.HoldDuration=0.6;q.MaxActivationDistance=10;q.Parent=p;nodes[i]=p\\n end\\n for i=1,14 do local a=i*2.399;local x=math.cos(a)*29;local z=math.sin(a)*29\\n  part('Cloudwood_Trunk',Vector3.new(2,9,2),Vector3.new(x,7,z),Color3.fromRGB(108,77,83))\\n  part('Cloudwood_Crown',Vector3.new(10,10,10),Vector3.new(x,14,z),Color3.fromRGB(100+i*3,144,191),nil,Enum.PartType.Ball)\\n end\\n for _,data in {{'AETHER HUB',Vector3.new(0,17,0)},{'WHISPERING MEADOWS',Vector3.new(0,18,-104)},{'YOUR ISLAND',Vector3.new(74,18,0)}} do\\n  local anchor=part('Sign',Vector3.one,data[2],cyan);anchor.Transparency=1;anchor.CanCollide=false\\n  local gui=Instance.new('BillboardGui');gui.Size=UDim2.fromOffset(320,54);gui.AlwaysOnTop=true;gui.MaxDistance=180;gui.Parent=anchor\\n  local text=Instance.new('TextLabel');text.Size=UDim2.fromScale(1,1);text.BackgroundTransparency=1;text.Text=data[1];text.TextColor3=Color3.fromRGB(242,227,183);text.TextScaled=true;text.Font=Enum.Font.GothamBold;text.Parent=gui\\n end\\n world:PivotTo(CFrame.new(220,80,0) * world:GetPivot())\\n world.Parent=workspace\\n return {model=world,nodes=nodes,merchant=merchant,heart=heart}\\nend\\nreturn World\\n\",\"ReplicatedStorage.SKYKEEPERS.Config.EconomyConfig\":\"-- Generated from config/economy.json; do not edit.\\nreturn {[\\\"routeSeconds\\\"]=300,[\\\"items\\\"]={[\\\"Cloudwood\\\"]={[\\\"rarity\\\"]=\\\"Common\\\",[\\\"price\\\"]=5},[\\\"Skyglass\\\"]={[\\\"rarity\\\"]=\\\"Uncommon\\\",[\\\"price\\\"]=12},[\\\"Starbloom\\\"]={[\\\"rarity\\\"]=\\\"Rare\\\",[\\\"price\\\"]=30},[\\\"Mistwood\\\"]={[\\\"rarity\\\"]=\\\"Uncommon\\\",[\\\"price\\\"]=12},[\\\"Moonstone\\\"]={[\\\"rarity\\\"]=\\\"Rare\\\",[\\\"price\\\"]=30},[\\\"AncientBark\\\"]={[\\\"rarity\\\"]=\\\"Epic\\\",[\\\"price\\\"]=80},[\\\"StormEssence\\\"]={[\\\"rarity\\\"]=\\\"Rare\\\",[\\\"price\\\"]=30},[\\\"CelestialOre\\\"]={[\\\"rarity\\\"]=\\\"Epic\\\",[\\\"price\\\"]=80},[\\\"TempestCore\\\"]={[\\\"rarity\\\"]=\\\"Legendary\\\",[\\\"price\\\"]=220}},[\\\"zones\\\"]={[\\\"WhisperingMeadows\\\"]={[\\\"count\\\"]=9,[\\\"drops\\\"]={{\\\"Cloudwood\\\",70},{\\\"Skyglass\\\",25},{\\\"Starbloom\\\",5}}},[\\\"CrystalRuins\\\"]={[\\\"count\\\"]=7,[\\\"drops\\\"]={{\\\"Mistwood\\\",55},{\\\"Moonstone\\\",40},{\\\"AncientBark\\\",5}}},[\\\"StormTemple\\\"]={[\\\"count\\\"]=4,[\\\"drops\\\"]={{\\\"StormEssence\\\",60},{\\\"CelestialOre\\\",38},{\\\"TempestCore\\\",2}}}},[\\\"upgrades\\\"]={{[\\\"coins\\\"]=250,[\\\"items\\\"]={[\\\"Cloudwood\\\"]=10,[\\\"Skyglass\\\"]=3}},{[\\\"coins\\\"]=850,[\\\"items\\\"]={[\\\"Skyglass\\\"]=12,[\\\"Starbloom\\\"]=5}},{[\\\"coins\\\"]=2200,[\\\"items\\\"]={[\\\"Mistwood\\\"]=10,[\\\"Moonstone\\\"]=8,[\\\"AncientBark\\\"]=2}},{[\\\"coins\\\"]=5000,[\\\"items\\\"]={[\\\"Moonstone\\\"]=12,[\\\"AncientBark\\\"]=8}}},[\\\"weapons\\\"]={[\\\"Skyblade\\\"]={[\\\"damage\\\"]=12,[\\\"interval\\\"]=0.8},[\\\"StormStaff\\\"]={[\\\"damage\\\"]=18,[\\\"interval\\\"]=1.25},[\\\"TitanHammer\\\"]={[\\\"damage\\\"]=29,[\\\"interval\\\"]=2}},[\\\"prototype\\\"]={[\\\"gatherDistance\\\"]=12,[\\\"sellDistance\\\"]=14,[\\\"inventoryCap\\\"]=200,[\\\"requestInterval\\\"]=0.25,[\\\"nodeCooldown\\\"]=300}}\\n\",\"ServerStorage.SKYKEEPERS_TESTS.Economy.spec\":\"return function(Economy,config)\\n local passed=0\\n local function check(v) assert(v);passed+=1 end\\n local d=config.zones.WhisperingMeadows.drops\\n check(Economy.roll(d,0)=='Cloudwood');check(Economy.roll(d,69.999)=='Cloudwood');check(Economy.roll(d,70)=='Skyglass');check(Economy.roll(d,95)=='Starbloom')\\n check(not pcall(Economy.roll,d,100));check(Economy.sellValue(config,{Cloudwood=2,Skyglass=1})==22)\\n local p={level=1,coins=250,inventory={Cloudwood=10,Skyglass=2}}\\n check(not Economy.upgrade(config,p));check(p.coins==250 and p.inventory.Cloudwood==10 and p.level==1)\\n p.inventory.Skyglass=3;check(Economy.upgrade(config,p));check(p.coins==0 and p.level==2 and p.inventory.Cloudwood==0)\\n check(not Economy.upgrade(config,p));check(p.level==2)\\n return passed\\nend\\n\",\"StarterPlayer.StarterPlayerScripts.SKYKEEPERS.Bootstrap\":\"local Players=game:GetService('Players');local player=Players.LocalPlayer\\nlocal shared=game:GetService('ReplicatedStorage'):WaitForChild('SKYKEEPERS')\\nlocal gui=Instance.new('ScreenGui');gui.Name='SKYKEEPERS_HUD';gui.ResetOnSpawn=false;gui.Parent=player:WaitForChild('PlayerGui')\\nlocal panel=Instance.new('TextLabel');panel.Position=UDim2.fromScale(0.04,0.06);panel.Size=UDim2.fromScale(0.48,0.22);panel.BackgroundColor3=Color3.fromRGB(22,30,53);panel.BackgroundTransparency=0.12;panel.TextColor3=Color3.fromRGB(235,226,198);panel.Font=Enum.Font.Gotham;panel.TextSize=18;panel.TextWrapped=true;panel.Parent=gui\\nlocal corner=Instance.new('UICorner');corner.CornerRadius=UDim.new(0,14);corner.Parent=panel\\nlocal constraint=Instance.new('UITextSizeConstraint');constraint.MinTextSize=12;constraint.MaxTextSize=19;constraint.Parent=panel;panel.TextScaled=true\\nlocal function draw(message)\\n panel.Text='SKYKEEPERS • DEVELOPMENT PREVIEW\\\\n'..(player:GetAttribute('SkyCoins') or 0)..' SC  |  Sky Heart '..(player:GetAttribute('SkyHeart') or 1)..'  |  Bag '..(player:GetAttribute('BagCount') or 0)..'/200\\\\n'..message..'\\\\nSession-only progress • Gather in the Meadows, sell at the merchant.'\\nend\\ndraw('Explore the floating islands')\\n