    <Item class="Folder" referent="1">
      <Properties>
        <string name="Name">SK_Stage05_Test</string>
      </Properties>
      <Item class="Script" referent="2">
        <Properties>
          <string name="Name">ProbeRunner</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local probe = require(game.ServerStorage.SK_Stage05_Test.Probe)
local actual = probe(7, 3)
if actual == 10 then
	print('[STAGE05][PASS] probe 7+3 = 10')
else
	warn(('[STAGE05][FAIL] probe 7+3 expected 10, got %s'):format(actual))
end
script:SetAttribute('Actual', actual)
script:SetAttribute('Passed', actual == 10)
script:SetAttribute('Completed', true)
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="3">
        <Properties>
          <string name="Name">RemoteServer</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players = game:GetService('Players')
local ReplicatedStorage = game:GetService('ReplicatedStorage')
local validate = require(game.ServerStorage.SK_Stage05_Test.RequestValidator)
local folder = Instance.new('Folder')
folder.Name = 'SK_Stage05_Remote_Test'
folder.Parent = ReplicatedStorage
local remote = Instance.new('RemoteEvent')
remote.Name = 'Exchange'
remote.Parent = folder
local state = {}
Players.PlayerRemoving:Connect(function(player) state[player] = nil end)
remote.OnServerEvent:Connect(function(player, data)
	local now = os.clock()
	local s = state[player] or {last = -math.huge, ids = {}, count = 0}
	state[player] = s
	local valid, reason = validate(data)
	local id = if type(data) == 'table' and type(data.id) == 'string' and #data.id <= 32 then data.id else ''
	if now - s.last < 0.15 then
		remote:FireClient(player, {id = id, status = 'rate_limited'})
		return
	end
	s.last = now
	if not valid then remote:FireClient(player, {id = id, status = reason}); return end
	if s.ids[id] then remote:FireClient(player, {id = id, status = 'duplicate'}); return end
	if s.count >= 64 then remote:FireClient(player, {id = id, status = 'quota'}); return end
	s.ids[id] = true
	s.count += 1
	remote:FireClient(player, {id = id, status = 'ok', value = data.value * 2, userId = player.UserId})
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="4">
    <Properties>
      <string name="Name">ServerStorage</string>
