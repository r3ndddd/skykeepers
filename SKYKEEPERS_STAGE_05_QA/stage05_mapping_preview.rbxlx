        <string name="Name">SK_Stage05_Test</string>
      </Properties>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Probe</string>
          <string name="Source"><![CDATA[--!strict
-- Intentional controlled defect for Stage 0.5. Kept separate from ResourceMath.
return function(a: number, b: number): number
	return a - b
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">RequestValidator</string>
          <string name="Source"><![CDATA[--!strict
-- Pure server-side validation. This module never trusts client identity or timing.
local function finite(n: any): boolean
	return type(n) == 'number' and n == n and math.abs(n) < math.huge
end
return function(data: any): (boolean, string)
	if type(data) ~= 'table' then return false, 'invalid_type' end
	local fields = 0
	for key in pairs(data) do
		fields += 1
		if fields > 3 or (key ~= 'id' and key ~= 'kind' and key ~= 'value') then return false, 'invalid_fields' end
	end
	if type(data.id) ~= 'string' or #data.id < 1 or #data.id > 32 then return false, 'invalid_id' end
	if data.kind ~= 'probe' then return false, 'invalid_kind' end
	if not finite(data.value) or data.value < 0 or data.value > 100 or data.value % 1 ~= 0 then return false, 'invalid_value' end
	return true, 'ok'
end
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="8">
    <Properties>
      <string name="Name">StarterPlayer</string>
