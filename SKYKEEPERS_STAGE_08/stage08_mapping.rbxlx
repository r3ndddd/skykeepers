      <Item class="ModuleScript" referent="2">
        <Properties>
          <string name="Name">DropService</string>
          <string name="Source"><![CDATA[local Drop = {}
local EPSILON=1e-9
local function finite(x)
 return type(x)=="number" and x==x and math.abs(x)<math.huge
end
function Drop.validate(rows, byId, zoneId)
 if type(rows)~="table" or type(byId)~="table" or type(zoneId)~="string" then return false,"type" end
 local n, maxIndex, sum=0,0,0
 for k,row in pairs(rows) do
  if not finite(k) or k<1 or k%1~=0 then return false,"index" end
  n+=1;maxIndex=math.max(maxIndex,k)
  if type(row)~="table" or type(row.id)~="string" or row.id=="" then return false,"resource" end
  if byId[row.id]~=row or row.zone~=zoneId then return false,"resource" end
  if not finite(row.probability) or row.probability<0 or row.probability>1 then return false,"probability" end
  if not finite(row.value) or row.value<0 then return false,"value" end
  sum+=row.probability
 end
 if n==0 or maxIndex~=n then return false,"empty_or_sparse" end
 if not finite(sum) or math.abs(sum-1)>EPSILON then return false,"sum" end
 return true
end
function Drop.choose(catalog, zoneId, randomValue)
 if type(catalog)~="table" or type(catalog.Zones)~="table" or type(zoneId)~="string" then return nil,"zone" end
 local zone=catalog.Zones[zoneId]
 if not zone then return nil,"zone" end
 local valid,reason=Drop.validate(zone.drops,catalog.ById,zoneId)
 if not valid then return nil,reason end
 if not finite(randomValue) or randomValue<0 or randomValue>=1 then return nil,"random" end
 local cumulative=0
 for _,row in ipairs(zone.drops) do
  cumulative+=row.probability
  if randomValue<cumulative then return row end
 end
 return nil,"uncovered_probability"
end
return Drop
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3">
        <Properties>
          <string name="Name">EconomyCore</string>
          <string name="Source"><![CDATA[-- Server-only transaction; injected liveness checks must not yield.
local Economy={};Economy.__index=Economy
local MAX=9007199254740991
local MAX_REQUESTS=4096
local function integer(n)
 return type(n)=="number" and n==n and n>=0 and n<=MAX and n%1==0
end
function Economy.new(inventory,catalog,isPlayerLive,canTrade)
 return setmetatable({inventory=inventory,catalog=catalog,isPlayerLive=isPlayerLive,canTrade=canTrade},Economy)
end
function Economy:sell(player,id,quantity,requestId)
 local session=self.inventory.sessions[player]
 if not session or not self.isPlayerLive(player) then return false,"player" end
 if not self.canTrade(player) then return false,"merchant" end
 if type(requestId)~="string" or #requestId<1 or #requestId>64 or not requestId:match("^[%w_%-]+$") then return false,"request" end
 if session.saleRequests[requestId] then return false,"duplicate" end
 if session.saleRequestCount>=MAX_REQUESTS then return false,"request_limit" end
 if type(id)~="string" or #id>64 then return false,"resource" end
 local item=self.catalog.ById[id]
 if not item then return false,"resource" end
 local owned=session.counts[id]
 if not integer(owned) or not integer(session.coins) then return false,"state" end
 if quantity=="all" then quantity=owned end
 if not integer(quantity) or quantity==0 then return false,"quantity" end
 if quantity>owned then return false,"insufficient" end
 local price=item.value
 if not integer(price) or price==0 then return false,"price" end
 if quantity>math.floor((MAX-session.coins)/price) then return false,"overflow" end
 local earned=quantity*price
 if not integer(earned) or earned>MAX-session.coins then return false,"overflow" end
 -- No yielding calls from checks through these writes: one Luau task commits together.
 session.counts[id]=owned-quantity
 session.coins+=earned
 session.saleRequests[requestId]=true
 session.saleRequestCount+=1
 return true,{id=id,quantity=quantity,earned=earned,balance=session.coins,remaining=session.counts[id]}
end
return Economy
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">InventoryService</string>
          <string name="Source"><![CDATA[-- Session-only, no DataStore, no currency. Inventory operations do not yield.
local Inventory={}
Inventory.__index=Inventory
local MAX=9007199254740991
function Inventory.new(catalog)
 return setmetatable({catalog=catalog,sessions={}},Inventory)
end
function Inventory:join(player)
 if player==nil or self.sessions[player] then return false end
 local counts={}
 for id in pairs(self.catalog.ById) do counts[id]=0 end
 self.sessions[player]={counts=counts,lastRequest=0,lastAt=-math.huge,coins=0,saleRequests={},saleRequestCount=0}
 return true
end
function Inventory:leave(player) self.sessions[player]=nil end
function Inventory:balance(player,id)
 local s=self.sessions[player]
 if not s or type(id)~="string" or not self.catalog.ById[id] then return nil end
 return s.counts[id]
end
function Inventory:award(player,id,amount)
 local s=self.sessions[player]
 if not s or type(id)~="string" or not self.catalog.ById[id] or amount~=1 then return false end
 local v=s.counts[id]
 if type(v)~="number" or v~=v or v<0 or v%1~=0 or v>=MAX then return false end
 s.counts[id]=v+1
 return true
end
return Inventory
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="5">
        <Properties>
          <string name="Name">MerchantService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Catalog=require(script.Parent.ResourceCatalog)
local inventory=require(script.Parent.SessionInventory)
local Economy=require(script.Parent.EconomyCore)
local merchant=workspace:WaitForChild("SK_Stage08_Merchant")
local point=merchant:WaitForChild("InteractionPoint")
local remote=Instance.new("RemoteEvent");remote.Name="SK08_Merchant";remote.Parent=ReplicatedStorage
local function live(player) return player.Parent==Players end
local function near(player)
 local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
 return root~=nil and merchant:IsDescendantOf(workspace) and point:IsDescendantOf(merchant) and (root.Position-point.Position).Magnitude<=12
end
local core=Economy.new(inventory,Catalog,live,near)
local function snapshot(player)
 local session=inventory.sessions[player]
 if not session then return nil end
 local rows={}
 for id,item in pairs(Catalog.ById) do table.insert(rows,{id=id,name=item.name,price=item.value,count=session.counts[id]}) end
 table.sort(rows,function(a,b)return a.name<b.name end)
 return {coins=session.coins,rows=rows}
end
local function send(player,kind,info)
 if live(player) then remote:FireClient(player,kind,info,snapshot(player)) end
end
local function ready(player)
 if inventory.sessions[player] then player:SetAttribute("SK08_SkyCoins",inventory.sessions[player].coins) end
end
Players.PlayerAdded:Connect(function(player) task.defer(function() ready(player) end) end)
for _,player in Players:GetPlayers() do task.defer(function() ready(player) end) end
local prompt=Instance.new("ProximityPrompt");prompt.Name="MerchantPrompt";prompt.ActionText="Trade";prompt.ObjectText="Sky Merchant";prompt.MaxActivationDistance=10;prompt.HoldDuration=.35;prompt.RequiresLineOfSight=false;prompt.Parent=point
prompt.Triggered:Connect(function(player) if near(player) and snapshot(player) then send(player,"open","") end end)
remote.OnServerEvent:Connect(function(player,action,id,quantity,requestId,...)
 if action~="sell" or select("#",...)~=0 then return end
 local ok,result=core:sell(player,id,quantity,requestId)
 if ok then
  player:SetAttribute("SK07_"..result.id,result.remaining)
  player:SetAttribute("SK08_SkyCoins",result.balance)
  send(player,"sold",result)
 else
  send(player,"rejected",type(result)=="string" and result or "error")
 end
end)
print("[SK08] merchant ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">ResourceCatalog</string>
          <string name="Source"><![CDATA[-- All balance values are user-approved; rarity assignments await a GDD decision.
local Catalog = {}
Catalog.RarityLevels = table.freeze({"TIER_1", "TIER_2", "TIER_3", "TIER_4", "TIER_5"})
Catalog.Zones = {
 WhisperingMeadows = {name="Whispering Meadows", gathers=9, drops={
  {id="Cloudwood", name="Cloudwood", probability=0.70, value=5},
  {id="Skyglass", name="Skyglass", probability=0.25, value=12},
  {id="Starbloom", name="Starbloom", probability=0.05, value=30},
 }},
 CrystalRuins = {name="Crystal Ruins", gathers=7, drops={
  {id="Mistwood", name="Mistwood", probability=0.55, value=12},
  {id="Moonstone", name="Moonstone", probability=0.40, value=30},
  {id="AncientBark", name="Ancient Bark", probability=0.05, value=80},
 }},
 StormTemple = {name="Storm Temple", gathers=4, drops={
  {id="StormEssence", name="Storm Essence", probability=0.60, value=30},
  {id="CelestialOre", name="Celestial Ore", probability=0.38, value=80},
  {id="TempestCore", name="Tempest Core", probability=0.02, value=220},
 }},
}
Catalog.ById = {}
for zoneId, zone in pairs(Catalog.Zones) do
 for _, item in ipairs(zone.drops) do
  assert(Catalog.ById[item.id] == nil, "duplicate resource id")
  item.zone=zoneId
  item.rarityStatus="PENDING_APPROVAL"
  Catalog.ById[item.id]=item
  table.freeze(item)
 end
 table.freeze(zone.drops)
 table.freeze(zone)
end
table.freeze(Catalog.Zones)
table.freeze(Catalog.ById)
return table.freeze(Catalog)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">ResourceCore</string>
          <string name="Source"><![CDATA[-- Adapter creates every input on the server. Gather path and RNG must not yield.
local Resource={};Resource.__index=Resource
local function finite(x) return type(x)=="number" and x==x and math.abs(x)<math.huge end
function Resource.new(inventory,catalog,drop,random,playerLive,resourceLive)
 return setmetatable({inventory=inventory,catalog=catalog,drop=drop,random=random,playerLive=playerLive,resourceLive=resourceLive,resources={}},Resource)
end
function Resource:register(node,zone)
 if node==nil or self.resources[node] or type(zone)~="string" or not self.catalog.Zones[zone] then return false end
 self.resources[node]={available=true,zone=zone};return true
end
function Resource:restore(node)
 local state=self.resources[node]
 if not state or not self.resourceLive(node) then return false end
 state.available=true;return true
end
function Resource:gather(player,node,request,distance,now)
 local session=self.inventory.sessions[player]
 if not session or not self.playerLive(player) then return false,"player" end
 local state=node~=nil and self.resources[node]
 if not state or not self.resourceLive(node) then return false,"resource" end
 if not finite(request) or request%1~=0 or request<=session.lastRequest then return false,"request" end
 if not finite(distance) or distance<0 or distance>12 then return false,"distance" end
 if not finite(now) then return false,"time" end
 if now-session.lastAt<0.5 then return false,"rate" end
 if not state.available then return false,"unavailable" end
 local selected,reason=self.drop.choose(self.catalog,state.zone,self.random())
 if not selected then return false,reason end
 if not self.inventory:award(player,selected.id,1) then return false,"award" end
 session.lastRequest=request;session.lastAt=now;state.available=false
 return true,selected
end
return Resource
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="8">
        <Properties>
          <string name="Name">ResourceService</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[local Players=game:GetService("Players")
local ReplicatedStorage=game:GetService("ReplicatedStorage")
local Catalog=require(script.Parent.ResourceCatalog)
local Drop=require(script.Parent.DropService)
local Inventory=require(script.Parent.InventoryService)
local Core=require(script.Parent.ResourceCore)
local island=workspace:WaitForChild("SK_Stage06_Island")
local zone="WhisperingMeadows"
assert(Drop.validate(Catalog.Zones[zone].drops,Catalog.ById,zone),"invalid zone drops")
local notice=Instance.new("RemoteEvent");notice.Name="SK_Stage07_Notice";notice.Parent=ReplicatedStorage
local inventory=require(script.Parent.SessionInventory)
local metrics=Instance.new("Folder");metrics.Name="SK_Stage07_Metrics";metrics.Parent=game:GetService("ServerStorage")
local function updateMetrics() local n=0 for _ in pairs(inventory.sessions) do n+=1 end metrics:SetAttribute("ActiveSessions",n) end
local function initialize(player)
 if inventory:join(player) then
  for id in pairs(Catalog.ById) do player:SetAttribute("SK07_"..id,0) end
  player:SetAttribute("SK08_SkyCoins",0)
  updateMetrics()
 end
end
Players.PlayerAdded:Connect(initialize)
Players.PlayerRemoving:Connect(function(player) inventory:leave(player);updateMetrics() end)
for _,player in Players:GetPlayers() do initialize(player) end
local nodes={}
for _,node in island:WaitForChild("Resources"):GetChildren() do if node:IsA("Model") then nodes[node]=true end end
for _,name in {"Skyglass_Decor","Starbloom_Decor"} do local node=island:FindFirstChild(name);if node and node:IsA("Model") then nodes[node]=true end end
local function nodeLive(node)
 return typeof(node)=="Instance" and nodes[node]==true and node:IsDescendantOf(island) and node:FindFirstChildWhichIsA("BasePart",true)~=nil
end
local rng=Random.new()
local core=Core.new(inventory,Catalog,Drop,function() return rng:NextNumber() end,function(p) return p.Parent==Players end,nodeLive)
local serial=0
local function install(node)
 local part=node:FindFirstChild("Trunk",true) or node:FindFirstChildWhichIsA("BasePart",true)
 if not part or not part:IsA("BasePart") or not core:register(node,zone) then warn("[SK07] Cannot install node "..node.Name);return end
 node.Destroying:Connect(function() nodes[node]=nil;core.resources[node]=nil end)
 local prompt=Instance.new("ProximityPrompt");prompt.Name="GatherResource";prompt.ActionText="Gather";prompt.ObjectText="Whispering Meadows";prompt.KeyboardKeyCode=Enum.KeyCode.E;prompt.MaxActivationDistance=10;prompt.HoldDuration=.35;prompt.RequiresLineOfSight=false;prompt.Parent=part
 local indicator=Instance.new("BillboardGui");indicator.Name="Regrowth";indicator.Size=UDim2.fromOffset(150,34);indicator.StudsOffset=Vector3.new(0,5,0);indicator.AlwaysOnTop=true;indicator.Enabled=false;indicator.Parent=part
 local label=Instance.new("TextLabel");label.Size=UDim2.fromScale(1,1);label.BackgroundTransparency=.25;label.BackgroundColor3=Color3.fromRGB(35,63,72);label.TextColor3=Color3.new(1,1,1);label.Font=Enum.Font.GothamBold;label.TextSize=14;label.Text="Regrowing...";label.Parent=indicator
 local flash=Instance.new("Highlight");flash.FillColor=Color3.fromRGB(160,240,255);flash.FillTransparency=.3;flash.OutlineTransparency=1;flash.Enabled=false;flash.Parent=node
 node:SetAttribute("Available",true)
 prompt.Triggered:Connect(function(player)
  local root=player.Character and player.Character:FindFirstChild("HumanoidRootPart")
  if not root then return end
  serial+=1
  local ok,selected=core:gather(player,node,serial,(root.Position-part.Position).Magnitude,os.clock())
  if not ok then return end
  node:SetAttribute("Available",false);prompt.Enabled=false;indicator.Enabled=true;flash.Enabled=true
  task.delay(.35,function() if flash.Parent then flash.Enabled=false end end)
  local balance=inventory:balance(player,selected.id)
  player:SetAttribute("SK07_"..selected.id,balance)
  notice:FireClient(player,selected.id,selected.name,1,balance)
  task.delay(15,function()
   if not core:restore(node) then return end
   node:SetAttribute("Available",true);prompt.Enabled=true;indicator.Enabled=false
  end)
 end)
end
for node in pairs(nodes) do install(node) end
print("[SK07] resource service ready")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">SessionInventory</string>
          <string name="Source"><![CDATA[-- One shared session store for collection and transactions in this server.
local Inventory=require(script.Parent.InventoryService)
local Catalog=require(script.Parent.ResourceCatalog)
return Inventory.new(Catalog)
]]></string>
        </Properties>
